# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cursor/*.log

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI artifacts
/supabase/.temp/

# högskoleprov importer (generated output)
/scripts/import-prov/downloads/
/scripts/import-prov/parsed/
/scripts/import-prov/figures/

# frågebank: underlag för andra kontrollen (frågor utan facit, kontrollantens svar)
/content/ovningsfragor/.andra-kontroll/

# Superdesign temporary HTML
.superdesign/tmp/
