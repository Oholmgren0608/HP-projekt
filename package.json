{
  "name": "hp-lift",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 43123",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db": "npx tsx scripts/db.ts",
    "db:push": "npx tsx scripts/db.ts db push",
    "db:dry": "npx tsx scripts/db.ts db push --dry-run",
    "fragebank:validate": "npx tsx scripts/fragebank/validate.ts",
    "fragebank:kontroll": "npx tsx scripts/fragebank/second-check.ts",
    "fragebank:upload": "npx tsx scripts/fragebank/upload.ts",
    "fragebank:export": "npx tsx scripts/fragebank/export-fallback.ts",
    "fragebank:balansera": "npx tsx scripts/fragebank/balance-legacy.ts",
    "fragebank:aldre": "npx tsx scripts/fragebank/legacy-check.ts",
    "dev:vinext": "vite dev --port 43124",
    "build:vinext": "vite build && next typegen",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "typecheck:cloudflare": "cf workers types && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@base-ui/react": "^1.7.0",
    "@supabase/supabase-js": "^2.115.0",
    "@vinext/cloudflare": "^1.4.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.2.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "~4.1.12"
  },
  "type": "module"
}
