# Kopiera dessa två värden från Supabase Dashboard:
# Klicka på "Connect" uppe till höger i projektöversikten (visar URL + key),
# eller gå till Settings -> API Keys. Använd en Publishable key
# (sb_publishable_...) — aldrig en Secret key.
# Kopiera den här filen till .env.local och fyll i värdena (committas aldrig).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---- Server-only (används ALDRIG i browsern) ------------------------------
# Admin-nyckel med fulla rättigheter (bypassar RLS). Läggs i .env.local,
# läses bara av serverkoden (src/lib/supabase/server.ts). Använd Secret key
# (service_role) — kommentera ALDRIG in den i klientkod och ge den inget
# NEXT_PUBLIC_-prefix.
SUPABASE_SERVICE_ROLE_KEY=...

# Samma Supabase-projekt som NEXT_PUBLIC_SUPABASE_URL, men utan NEXT_PUBLIC_
# så att värdet inte bäddas in i klientbundle. Valfritt — faller tillbaka på
# NEXT_PUBLIC_SUPABASE_URL om den saknas.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Komma-separerad allowlist över vilka Google-e-postadresser som får granska
# utkast på /review. Jämförs mot sessionens e-post (skiftlägesokänsligt).
REVIEW_ALLOWED_EMAILS=du@exempel.se,kollega@exempel.se

# ---- E-postutskick (bekräftelsemejl + lösenordsåterställning) ------------
# Supabases inbyggda mejltjänst används som standard men har en gräns på
# 2 mejl/timme. Vill man skicka ut fler mejl (fler registreringar/åter-
# ställningar) måste man konfigurera en egen SMTP-server:
#   Supabase Dashboard -> Settings -> Auth -> SMTP Settings
# (t.ex. Resend/SendGrid/Mailgun). Inga env-variabler behövs i appen —
# mejlutskick sköts helt av Supabase Auth, inte av appkoden.
